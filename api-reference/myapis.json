{
  "openapi": "3.1.0",
  "info": {
    "title": "Map Service",
    "description": "\n    Map Service provides map data.\n    \n    ## Authentication\n\n    For all endpoints, you need to include your Authentication token as a header: `Authorization: Bearer token`\n    ",
    "version": "0.1.0"
  },
