  "paths": {
    "/layers/query": {
      "post": {
        "tags": [
          "Map API"
        ],
        "summary": "Query Map Layers",
        "description": "Query one or more map layers with optional filters and bounding box.\n\nThis endpoint allows clients to request multiple map layers in a single\ncall. Each layer may be specified as a simple name or with extended\noptions (fields, filters, bbox).\n\nArgs:\n    req (Request): The FastAPI request context.\n    request (MapQueryRequest): Map query definition including:\n        - ``layers``: List of layer names or detailed layer inputs.\n        - ``filters``: Optional per-entity filter definitions.\n        - ``bbox``: Optional bounding box [minx, miny, maxx, maxy].\n        - ``context``: Optional context values (e.g. site_id).\n        - ``auto_fit``: Whether to auto-fit map viewport.\n\nReturns:\n    MapQueryResponse: A collection of layer results, each in a\n    GeoJSON-compatible structure with metadata.\n\nExample:\n    **Multi-Layer Request**\n\n    .. code-block:: json\n\n        {\n          \"layers\": [\"devices\", \"device_links\", \"nodes\", \"node_device_links\"],\n          \"filters\": {\n            \"devices\": {\n              \"status\": [\"Online\"],\n              \"prod_id\": 277\n            }\n          },\n          \"bbox\": [\n            -84.16284088122629,\n            33.89537509010729,\n            -84.04194348920977,\n            33.99224608410038\n          ],\n          \"context\": {\"site_id\": \"13111e33-285e-40c1-8bbc-538bef2fa9e2\"},\n          \"auto_fit\": false\n        }",
        "operationId": "query_map_layers_layers_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MapQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MapQueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "gatewayHeader": []
          }
        ]
      }
    },
